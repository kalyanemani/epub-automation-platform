# ── Python RAG Service — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM: Fireworks AI (required for local dev and as cloud fallback) ──────────
# Get your key at https://fireworks.ai
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro
FIREWORKS_TIMEOUT_S=20

# ── LLM: Ollama (optional — leave blank for local dev, set for AWS production) ─
# OLLAMA_PRIMARY_URL=http://localhost:11434
# OLLAMA_FALLBACK_URL=
OLLAMA_DISCOVERY_TIMEOUT_MS=4000
OLLAMA_PRIMARY_TIMEOUT_S=30
OLLAMA_LOCAL_TIMEOUT_S=30

# ── Ollama model selection (only used when OLLAMA_PRIMARY_URL is set) ──────────
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_VISION=qwen2.5vl:7b
OLLAMA_MODEL_REASONING=qwen3:14b
OLLAMA_MODEL_STRUCTURED=qwen2.5:7b
OLLAMA_MODEL_CODEGEN=qwen2.5-coder:14b

# ── Service URLs ───────────────────────────────────────────────────────────────
NODE_API_URL=http://localhost:9000
PYTHON_API_PORT=8001

# ── Storage ────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# CHROMA_HOST=localhost

# ── Security ──────────────────────────────────────────────────────────────────
# Set a strong random string to enable API key authentication.
# Leave blank to run without auth (local dev only).
SERVICE_API_KEY=

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200
AUTOFIX_NODE_TIMEOUT_S=300
