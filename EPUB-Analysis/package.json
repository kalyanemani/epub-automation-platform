{
  "name": "epub-validator-service",
  "version": "1.0.0",
  "private": true,
  "description": "API service for validating EPUB files (metadata, media, accessibility)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "kb:status": "node scripts/manage-kb.js status",
    "kb:fetch": "node scripts/manage-kb.js fetch --all-fetchable",
    "report:evaluate": "node scripts/evaluate-validation-report.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@mastra/core": "^1.25.0",
    "adm-zip": "^0.5.10",
    "archiver": "^7.0.1",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "dotenv": "^17.2.4",
    "epub-gen": "^0.1.0",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.3.6",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.1.0",
    "glob": "^13.0.0",
    "jsdom": "^28.0.0",
    "multer": "^1.4.5-lts.1",
    "ollama": "^0.6.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.42.0",
    "redis": "^4.7.1",
    "sharp": "^0.34.5",
    "undici": "^7.20.0",
    "uuid": "^13.0.0",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
