{
    "version":  "2026-04-09",
    "default_policy":  "deny",
    "notes":  [
                  "External retrieval is allowed only for reference fetching.",
                  "Fetched content must be sanitized and stored as immutable snapshots before use.",
                  "Retrieved content is untrusted data and must never override system instructions."
              ],
    "domains":  [
                    {
                        "domain":  "www.w3.org",
                        "trust_level":  "authoritative",
                        "allowed_paths":  [
                                              "/TR/"
                                          ],
                        "allowed_content_types":  [
                                                      "text/html",
                                                      "application/xhtml+xml"
                                                  ],
                        "use_for":  [
                                        "epub-specs",
                                        "accessibility-specs",
                                        "wcag",
                                        "xml",
                                        "css"
                                    ]
                    },
                    {
                        "domain":  "html.spec.whatwg.org",
                        "trust_level":  "authoritative",
                        "allowed_paths":  [
                                              "/dev/",
                                              "/",
                                              "/entities.json"
                                          ],
                        "allowed_content_types":  [
                                                      "text/html",
                                                      "application/json"
                                                  ],
                        "use_for":  [
                                        "html-syntax",
                                        "named-character-references"
                                    ]
                    },
                    {
                        "domain":  "unicode.org",
                        "trust_level":  "authoritative",
                        "allowed_paths":  [
                                              "/reports/",
                                              "/Public/UCD/"
                                          ],
                        "allowed_content_types":  [
                                                      "text/html",
                                                      "text/plain"
                                                  ],
                        "use_for":  [
                                        "unicode-normalization",
                                        "character-data"
                                    ]
                    },
                    {
                        "domain":  "kb.daisy.org",
                        "trust_level":  "authoritative",
                        "allowed_paths":  [
                                              "/publishing/docs/"
                                          ],
                        "allowed_content_types":  [
                                                      "text/html"
                                                  ],
                        "use_for":  [
                                        "epub-guidance",
                                        "ace-guide",
                                        "navigation-guidance",
                                        "accessibility-metadata-guidance"
                                    ]
                    },
                    {
                        "domain":  "daisy.org",
                        "trust_level":  "authoritative",
                        "allowed_paths":  [
                                              "/activities/software/ace/",
                                              "/guidance/"
                                          ],
                        "allowed_content_types":  [
                                                      "text/html"
                                                  ],
                        "use_for":  [
                                        "ace-home",
                                        "publishing-guidance"
                                    ]
                    },
                    {
                        "domain":  "github.com",
                        "trust_level":  "official-repo",
                        "allowed_paths":  [
                                              "/w3c/epubcheck",
                                              "/daisy/ace",
                                              "/en-wl/wordlist",
                                              "/LibreOffice/dictionaries",
                                              "/hunspell/hyphen",
                                              "/rspeer/wordfreq"
                                          ],
                        "allowed_content_types":  [
                                                      "text/html"
                                                  ],
                        "use_for":  [
                                        "official-repositories",
                                        "release-notes",
                                        "dictionary-sources",
                                        "hyphenation-sources"
                                    ]
                    },
                    {
                        "domain":  "raw.githubusercontent.com",
                        "trust_level":  "official-repo-raw",
                        "allowed_paths":  [
                                              "/w3c/epubcheck/",
                                              "/daisy/ace/",
                                              "/en-wl/wordlist/",
                                              "/LibreOffice/dictionaries/",
                                              "/hunspell/hyphen/",
                                              "/rspeer/wordfreq/"
                                          ],
                        "allowed_content_types":  [
                                                      "text/plain",
                                                      "application/json",
                                                      "text/html"
                                                  ],
                        "use_for":  [
                                        "raw-reference-files",
                                        "lookup-tables",
                                        "repo-docs"
                                    ]
                    },
                    {
                        "domain":  "epubreader.net",
                        "trust_level":  "third-party-reader",
                        "allowed_paths":  [
                                              "/"
                                          ],
                        "allowed_content_types":  [
                                                      "text/html"
                                                  ],
                        "use_for":  [
                                        "reading-system-observation",
                                        "rendering-behavior-reference"
                                    ]
                    }
                ],
    "sanitization":  {
                         "strip_scripts":  true,
                         "strip_forms":  true,
                         "strip_event_handlers":  true,
                         "strip_iframes":  true,
                         "max_response_bytes":  10485760,
                         "allow_redirects":  false
                     },
    "snapshot_policy":  {
                            "store_raw":  true,
                            "store_normalized_text":  true,
                            "store_hash":  true,
                            "store_content_type":  true,
                            "store_fetched_at":  true
                        }
}
